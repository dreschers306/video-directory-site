---
title: "Video Directory" 
layout: "base.njk" 
pagination:
  data: collections.video # Use the SHUFFLED video collection
  size: 4 # Items per page << ADJUSTED
  alias: videosOnPage # Variable for items on current page
---

{# Template content below #}

{# --- START: Tags Section --- #}
<div class="tags-section">
  <div class="tag-list">
    {# Loop over the 'items' array within collections.tagList #}
    {%- for tag in collections.tagList.items -%} 
      {# Final link structure with slugify #}
      <a href="/tags/{{ tag | slugify }}/" class="tag-box">{{ tag }}</a> 
    {%- else -%}
       <p style="color: red;">Tag list collection is empty!</p>
    {%- endfor -%}

    {# Check totalCount against the limit (using 3 for testing) #}
    {%- if collections.tagList.totalCount > 15 -%} 
      <a href="/tags/" class="tag-box tag-box--more">See all tags &rarr;</a>
    {%- endif -%}
  </div>
</div>
{# --- END: Tags Section --- #}

{# Keep your <div class="video-grid"> below this #}

{# Container for our video grid #}
<div class="video-grid">

  {# Loop through each video in our 'video' collection #}
  {%- for video in videosOnPage -%} 

    <article class="video-item" 
    data-date="{{ video.data.dateAdded }}"> {# Add date for potential JS sorting later #}
    data-pagefind-index-attrs="data-date"> {# Optional: index date? #}
      <a href="{{ video.url }}" 
     {# Explicitly define metadata for Pagefind #}
       data-pagefind-meta="videoId:{{ video.data.videoId }}"
       {# Tell Pagefind which image belongs to this result #}
       data-pagefind-image="{{ video.data.bunnyThumbnailUrl }}"
       data-pagefind-image-alt="Thumbnail for video {{ video.data.videoId }}"
       {# Add tags as filterable facets #}
       {%- for tag in video.data.tags | stringToArray %}
         data-pagefind-filter="tag:{{ tag }}"
       {%- endfor %}> 

        {# Add data-pagefind-ignore to prevent indexing raw img/video tags as text #}
        <div class="thumbnail-container" data-pagefind-ignore>
          {# Static thumbnail image #}
          <img 
            src="{{ video.data.bunnyThumbnailUrl }}" 
            alt="Thumbnail for video {{ video.data.videoId }}" 
            loading="lazy" {# Improve performance #}
            width="320" {# Add dimensions for better layout stability #}
            height="180"
            class="static-thumb"> 

          {# Animated Preview Image (.webp) #}
          {% if video.data.bunnyPreviewVideoUrl %}
            <img 
              src="{{ video.data.bunnyPreviewVideoUrl }}" {# <--- Changed from <video> to <img> #}
              alt="Preview for video {{ video.data.videoId }}"
              loading="lazy" {# Lazy load preview too #}
              width="320"
              height="180" 
              class="img-preview"> {# <--- Added class, changed from video-preview #}
          {% endif %}
        </div>

        {# Weight the videoId so it shows up prominently #}
      <p class="video-id-title" data-pagefind-weight="2">{{ video.data.videoId }}</p> 
    </a>
    {# Optional: Add tags explicitly to body text for indexing? #}
    {# <div data-pagefind-ignore style="display:none;">Tags: {{ video.data.tags }}</div> #}
  </article>

  {%- else -%}
    {# Optional: Message if no videos exist yet #}
    <p>No videos found for this page.</p>
  {%- endfor -%}

</div>

{# --- START: Pagination Navigation (Unstyled Logic) --- #}
<nav class="pagination-nav" aria-label="Pagination">
  <ul class="pagination-list">
    {# Link to Previous Page (if it exists) #}
    {% if pagination.previousPageHref %}
      <li><a href="{{ pagination.previousPageHref }}">&larr; Previous</a></li>
    {% endif %}

    {# Links to Individual Pages (Optional but nice) #}
    {%- for pageEntry in pagination.pages %}
      <li>
        <a href="{{ pagination.hrefs[ loop.index0 ] }}" {% if page.url == pagination.hrefs[ loop.index0 ] %} aria-current="page"{% endif %}>
          {{ loop.index }}
        </a>
      </li>
    {%- endfor %}

    {# Link to Next Page (if it exists) #}
    {% if pagination.nextPageHref %}
      <li><a href="{{ pagination.nextPageHref }}">Next &rarr;</a></li>
    {% endif %}
  </ul>
</nav>
{# --- END: Pagination Navigation --- #}