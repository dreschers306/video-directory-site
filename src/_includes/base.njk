<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or "Video Directory" }}</title> {# Use page title, or default #}
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet">
    <script src="/pagefind/pagefind-ui.js" defer></script> 
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <header class="site-header">
      <div class="header-container">
        {# Site Title/Logo - Make it a link to the homepage #}
        <a href="/" class="site-title">{{ title or "Video Directory" }}</a> 

        <div id="search" class="search-container"></div>

      </div>
    </header>

    <main> 
      {% block content %}
        {{ content | safe }} 
      {% endblock %}
    </main>

    <footer>
      <p>&copy; 2025 Your Site Name</p>
    </footer>

    {# Add link to your main JavaScript file if needed later #}
    <script src="/js/main.js" defer></script> 
  </body>
</html>