<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or "Video Directory" }}</title> {# Use page title, or default #}
    <link rel="stylesheet" href="/css/style.css"> {# We'll create this later #}
  </head>
  <body>
    <header class="site-header">
      <div class="header-container">
        {# Site Title/Logo - Make it a link to the homepage #}
        <a href="/" class="site-title">{{ title or "Video Directory" }}</a> 

        {# Search Form - Action will be handled by JS later #}
        <form action="#" id="search-form" class="search-form" role="search">
          <label for="search-input" class="visually-hidden">Search Videos</label>
          <input type="search" id="search-input" name="q" placeholder="Search by ID or tag..." aria-label="Search Videos">
          <button type="submit">Search</button> 
          {# We might hide/style the button later if search is instant #}
        </form>
      </div>
    </header>

    <main>
      {# Define the content block that child layouts like video.njk will fill #}
      {% block content %} 
        {# This default content variable is used by pages *not* using extends/block #}
        {{ content | safe }} 
      {% endblock %}
    </main>

    <footer>
      <p>&copy; 2025 Your Site Name</p>
    </footer>

    {# Add link to your main JavaScript file if needed later #}
    <script src="/js/main.js" defer></script> 
  </body>
</html>