{% extends "base.njk" %} {# Inherit the header, footer, etc. from the main layout #}

{% block content %} {# Define the main content area for this layout #}
  <article class="video-page">
    <h2>Video Details Page</h2>
    {# Access front matter data directly using the key name #}
    <h3>ID: {{ videoId }}</h3> 

{# Container to maintain aspect ratio #}
<div class="video-player-container"> 
  {% if bunnyVideoUrl %}
    <iframe
      src="{{ bunnyVideoUrl }}" {# Use variable for the source #}
      loading="lazy"
      style="border: none; position: absolute; top: 0; height: 100%; width: 100%;"
      allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
      allowfullscreen="true"
    ></iframe>
  {% else %}
    <p>Error: Video URL not found!</p> {# Fallback message #}
  {% endif %}
</div>

    {# Placeholder for metadata #}
    <div class="video-metadata">
      <h4>Metadata:</h4>
      <p>Tags: {{ tags | stringToArray | join(", ") }}</p> {# Use our filter #}
      <p>Source Group ID: {{ sourceGroupId | default("N/A") }}</p>
      <p>Source URL: {{ sourceUrl | default("N/A") }}</p>
      <p>Affiliate Link: {{ affiliateLink | default("N/A") }}</p>
      <p>Date Added: {{ dateAdded }}</p> {# We can display it here even if hidden elsewhere #}
    </div>

    {# Placeholder for Related Videos #}
    <div class="related-videos" style="margin-top: 2em; border-top: 1px solid #ccc; padding-top: 1em;">
      <h4>Related Videos Placeholder</h4>
    </div>
     {# Placeholder for Sharing Buttons #}
    <div class="sharing-buttons" style="margin-top: 1em; border-top: 1px solid #ccc; padding-top: 1em;">
        <h4>Sharing Placeholder</h4>
    </div>

  </article>
{% endblock %}