{% extends "base.njk" %}

{% block content %}
  <article class="video-page">

    {# Video ID as Main Title #}
    <h1 class="video-main-title">{{ videoId }}</h1> 

    {# Video Player Container #}
    <div class="video-player-container"> 
      {% if bunnyVideoUrl %}
        <iframe src="{{ bunnyVideoUrl }}" loading="lazy" style="border: none; position: absolute; top: 0; height: 100%; width: 100%;" allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;" allowfullscreen="true"></iframe>
      {% else %}
        <p style="color: red; padding: 2em;">Error: Video URL not found!</p>
      {% endif %}
    </div>

    {# Action Buttons #}
    <div class="video-actions"> 
      <button type="button" id="copy-link-button" class="action-button">Copy Link</button>
      <span id="copy-link-feedback" class="feedback-message" aria-live="polite"></span>
    </div>

    {# Metadata Section - Includes Related Links Now #}
    <div class="video-metadata">
      <dl>
        {# --- Tags --- #}
        <dt>Tags:</dt>
        <dd class="tag-list-inline"> 
          {%- set videoTags = tags | stringToArray -%} 
          {%- if videoTags.length > 0 -%}
            {%- for tag in videoTags -%}
              <a href="/tags/{{ tag | slugify }}/" class="tag-box">{{ tag }}</a>
            {%- endfor -%}
          {%- else -%}
            <span>N/A</span> 
          {%- endif -%}
        </dd>

        {# --- Source Group ID (Hidden) --- #}
        {# {% if sourceGroupId %}
          <dt>Source Group ID:</dt>
          <dd>{{ sourceGroupId }}</dd> 
        {% endif %} #}

        {# --- Related Clips (as Links) --- #}
        {% if sourceGroupId %} 
          {# Call filter to get limited, shuffled list #}
          {% set relatedVideos = collections.video | filterBySourceGroup(sourceGroupId, page.url, 10) %} {# Limit to 10 links #}

          {% if relatedVideos.length > 0 %}
            <dt>Related Clips:</dt>
            <dd>
              {# Loop and create simple links, separated by comma/space #}
              {%- for relatedVideo in relatedVideos %}
                <a href="{{ relatedVideo.url }}">{{ relatedVideo.data.videoId }}</a>{% if not loop.last %}, {% endif %} 
              {%- endfor -%}
            </dd>
          {% endif %} {# End if relatedVideos.length > 0 #}
        {% endif %} {# End if sourceGroupId #}
        {# --- End Related Clips --- #}

        {# --- Source URL --- #}
        {% if sourceUrl %}
          <dt>Source URL:</dt>
          <dd><a href="{{ sourceUrl }}" target="_blank" rel="noopener noreferrer nofollow">Source</a></dd> 
        {% endif %}

        {# --- Affiliate Link --- #}
        {% if affiliateLink %}
          <dt>Affiliate Link:</dt>
          <dd><a href="{{ affiliateLink }}" target="_blank" rel="noopener noreferrer nofollow sponsored">Check Offer</a></dd> 
        {% endif %}

      </dl>
    </div>
    {# --- END Metadata Section --- #}

    {# --- REMOVED Separate Related Videos Grid --- #}

    {# --- START: Suggested Videos Section --- #}

{# Get filtered AND sliced list directly from our updated filter #}
{% set suggestedVideos = collections.video | filterOutUrl(page.url, 3) %} {# Limit to 5 #}

{% if suggestedVideos.length > 0 %}
  <div class="suggested-videos" style="margin-top: 2em; border-top: 1px solid #ccc; padding-top: 1em;">
    <h3>Suggested Videos</h3>
    {# Reuse the video-grid class for layout #}
    <div class="video-grid"> 
      {%- for suggestedVideo in suggestedVideos -%}
        {# Render the standard video item article #}
        <article class="video-item"> 
          <a href="{{ suggestedVideo.url }}">
            <div class="thumbnail-container">
              <img src="{{ suggestedVideo.data.bunnyThumbnailUrl }}" 
                   alt="Thumbnail for video {{ suggestedVideo.data.videoId }}" 
                   loading="lazy" width="320" height="180" class="static-thumb">
              {% if suggestedVideo.data.bunnyPreviewVideoUrl %}
                  <img src="{{ suggestedVideo.data.bunnyPreviewVideoUrl }}" 
                       alt="Preview for video {{ suggestedVideo.data.videoId }}" 
                       loading="lazy" width="320" height="180" 
                       class="img-preview">
              {% endif %}  
            </div>
            <p class="video-id-title">{{ suggestedVideo.data.videoId }}</p>
          </a>
        </article>
      {%- endfor -%}
    </div>
  </div>
{% endif %} {# End if suggestedVideos.length > 0 #}
{# --- END: Suggested Videos Section --- #}

  </article>
{% endblock %}